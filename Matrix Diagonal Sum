class Solution {
public:
    int diagonalSum(vector<vector<int>>& mat) {
        int k = mat.size();
        int sum = 0;
        for (int i = 0; i < k; i++) {
            if (i == k - i - 1) {
                sum += mat[i][i];
            } else {
                sum += mat[i][i] + mat[i][k - i - 1];
            }
        }
        return sum;
    }
};
