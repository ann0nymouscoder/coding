class Solution {
public:
    int diagonalSum(vector<vector<int>>& mat) 
    {
    int k=mat.size();//rows
   // int l=mat[0].size();//cols
    int sum=0;
    for(int i=0;i<k;i++)
    {
        for(int j=0;j<k;j++)
        {
            if(i==j || (i==0 && j==k-1)|| (i==k-1 && j==0)|| (i==k-1 && j==k-1))
            {
                sum+=mat[i][j];
                continue;
            }
            if(k%2==0)
            {
                if((i==(k/2)-1 && j==k/2)||(i==k/2 && j==(k/2)-1))
              {
                sum+=mat[i][j];
              }
            }
        }
    }    
    return sum;
    }
};
