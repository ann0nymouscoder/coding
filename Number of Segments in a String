class Solution {
public:
    int countSegments(string s) 
    {
        int count = 0;
        int k = s.length();
        
        if(k == 0)
        {
            return count;
        }
        
        for(int i = 0; i < k; i++)
        {
            if(s[i] != ' ' && (i == 0 || s[i-1] == ' '))
            {
                count++;
            }
        }
        
        return count;
    }
};
