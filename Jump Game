class Solution {
public:
    bool canJump(vector<int>& nums) {
        int j = nums.size() - 1;
        int k = 0;

        if (j == 0) {
            return true;
        }

        for (int i = 0; i <= k; i++) {
            if (i + nums[i] > k) {
                k = i + nums[i];
            }
            if (k >= j) {
                return true;
            }
        }

        return false;
    }
};
