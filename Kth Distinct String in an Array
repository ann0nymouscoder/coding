class Solution {
public:
    string kthDistinct(vector<string>& arr, int k) 
    {
        int count = k;
        string s = "";
        unordered_map<string, int> arr1;
        for (const string& i : arr) {
            arr1[i]++;
        }
        for (const string& str : arr) {
            if (arr1[str] == 1) {
                count--;
                if (count == 0) {
                    s = str;
                    return s;
                }
            }
        } 
        return s;
    }
};
