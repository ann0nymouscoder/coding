class Solution {
public:
    int minimumLength(string s) 
    {
    int k=s.length();
    if(k==2)
    {
        return k;
    }
    unordered_map<char,int> al;
  int count=0;
    for(char a: s)
    {
        al[a]++;
        if(al[a]==3)
        {
            count=count-1;
            al[a]=al[a]-2;
        }
        else
        {
            count++;
        }
    }    
    return count;
    }
};
