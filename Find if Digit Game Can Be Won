class Solution {
public:
    bool canAliceWin(vector<int>& nums) 
    {
    int t=nums.size();
    int less=0;
    int more=0;
    for(int i=0;i<t;i++)
    {
        if(nums[i]<10)
        {
            less=less+nums[i];
        }
        else
        {
            more=more+nums[i];
        }
    } 
    if(less==more)
    {
        return false;
    }   
    return true;
    }
};
