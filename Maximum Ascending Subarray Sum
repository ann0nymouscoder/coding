class Solution {
public:
    int maxAscendingSum(vector<int>& nums) 
    {
    int sum=nums[0];
    int k=nums.size();
    int maxi=0;
    if(k==1)
    {
        return nums[0];
    }
    for(int i=0;i<k;i++)
    {
        if(i==k-1)
        {
            break;
        }
        sum=nums[i];
        for(int j=i+1;j<k;j++)
        {
            if(nums[j]>nums[j-1])
            {
                sum=sum+nums[j];
            }
            else
            {
                break;
            }
        }
        maxi=max(maxi,sum);
        sum=0;
    }  
    return maxi;  
    }
};
