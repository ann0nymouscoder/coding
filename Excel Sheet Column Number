class Solution {
public:
    int titleToNumber(string columnTitle) 
    {
    int k=columnTitle.length();
    int p=0;
    int sum=0;
    if(k==1)
    {
        p=columnTitle[0]-'A'+1;
        return p;
    }
    for(int i=0;i<k;i++)
    {
       sum= sum+(columnTitle[i]-'A'+1)*pow(26,k-i-1);
    }
    return sum;    
    }
};
