class Solution {
public:
    vector<int> asteroidCollision(vector<int>& asteroids) 
    {
    stack<int> a;
    stack<int> b;
    vector<int> last;
    int k=asteroids.size();
    for(int i=0;i<k;i++)
    {
        if(asteroids[i]>0)
        {
            a.push(asteroids[i]);
        }
        else
        {
             while (!a.empty() && a.top() > 0 && a.top() < abs(asteroids[i]))
                {
                    a.pop();
                }
                if (!a.empty() && a.top() == abs(asteroids[i]))
                {
                    a.pop();
                }
                else if (a.empty() || a.top() < 0)
                {
                    a.push(asteroids[i]);
                }
        }    
    }
    while (!a.empty())
        {
            last.insert(last.begin(), a.top());
            a.pop();
        }
return last;
    }
};
