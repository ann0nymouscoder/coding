class Solution {
public:
    string makeFancyString(string s) 
    {
    string another="";
    int count=1;
    char a=s[0];
    another+=a;
    int k=s.length();
    for(int i=1;i<k;i++)
    {
        if(a==s[i])
        {
            count++;
            if(count==1 || count==2)
            {
                another+=a;
            }
            else 
            {
                continue;
            }
        }
        else
        {
            count=0;
        a=s[i];
        count++;
        another+=a;
        }
    }
    return another;     
    }
};
