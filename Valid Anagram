class Solution {
public:
    bool isAnagram(string s, string t) 
    {
        int a=s.length();
        int b=t.length();
        if(a<b || a>b)
        {
            return false;
        }
    unordered_map<char ,int> first;
    unordered_map<char ,int> second; 
    for(int i=0;i<a;i++)
    {
        first[s[i]]++;
    }  
    for(int i=0;i<b;i++)
    {
        second[t[i]]++;
    }
     for (const auto &pair : first) 
            {
            if (second[pair.first] != pair.second) {
                return false;
            }
            }
            return true;
            
    }
};
