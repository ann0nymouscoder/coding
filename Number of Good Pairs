class Solution {
public:
    int numIdenticalPairs(vector<int>& nums) 
    {
        int count=0;
        int k=nums.size();
    for(int i=0;i<k;i++)
    {
        for(int j=i+1;j<k;j++)
        {
            if(nums[i]==nums[j])
            {
                count++;
            }
        }
    }    
    return count;
    }
};
