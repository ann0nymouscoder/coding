/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* reverseKGroup(ListNode* head, int k) {
        if (head == NULL || k == 1) {
            return head;
        }
        ListNode* newHead = NULL;
        ListNode* tail = NULL;
        int count = 0;

        ListNode* temp = head;
        while (temp != NULL) {
            count++;
            temp = temp->next;
        }
        
        while (count >= k) {
            temp = head;
            stack<ListNode*> nodeStack;

            for (int i = 0; i < k; i++) {
                nodeStack.push(temp);
                temp = temp->next;
            }
            
            while (!nodeStack.empty())
            {
                if (newHead == NULL) 
                {
                    newHead = nodeStack.top();
                    tail = newHead;
                } else 
                {
                    tail->next = nodeStack.top();
                    tail = tail->next;
                }
                nodeStack.pop();
            }
            
            tail->next = temp;
            head = temp;
            count -= k;
        }
        
        return newHead;
    }
};
