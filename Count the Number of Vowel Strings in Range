class Solution {
public:
    int vowelStrings(vector<string>& words, int left, int right) 
    {
        int k=words.size();
        int count=0;
        for(left;left<=right;left++)
        {
            int z=words[left].length()-1;
            if(words[left][0]=='a'||words[left][0]=='e'||words[left][0]=='i'||words[left][0]=='o'||words[left][0]=='u')
            {
                if(words[left][z]=='a'||words[left][z]=='e'||words[left][z]=='i'||words[left][z]=='o'||words[left][z]=='u')
                {
                    count++;
                }
            }
        }
        return count;
    }
};
