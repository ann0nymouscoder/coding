class Solution {
public:
    bool palindrome(int n){
        vector<int> nums;
        while(n != 0){
            nums.push_back(n % 10);
            n /= 10;
        }
        reverse(nums.begin(), nums.end());
        int m = nums.size();
        for(int i = 0; i <= m/2; i++){
            if(nums[i] != nums[m - 1 - i]){
                return false;
            }
        }
        return true;
    }
    long long minimumCost(vector<int>& nums) {
        int n = nums.size();
        long long totalCost = 0;
        sort(nums.begin(), nums.end());
        if(palindrome(nums[n/2])){
            for(int i = 0; i < n; i++){
                totalCost += abs(nums[i] - nums[n/2]);
            }
            return totalCost;
        }
        int ans1 = INT_MAX;
        int ans2 = INT_MAX;
        for(int i = nums[n/2] -1; i >= 1; i--){
            if(palindrome(i)){
                ans1 = i;
                break;
            }
        }
        for(int i = nums[n/2] + 1; i <= INT_MAX; i++){
            if(palindrome(i)){
                ans2 = i;
                break;
            }
        }
        int mini;
        totalCost = 0;
        long long totalCost1 = 0;
        long long totalCost2 = 0;
        for(int i = 0; i < n; i++){
            totalCost1 += abs(nums[i] - ans1);
        }
        for(int i = 0; i < n; i++){
            totalCost2 += abs(nums[i] - ans2);
        }
        totalCost = min(totalCost1, totalCost2);
        return totalCost;
    }
};
