class Solution {
public:
    bool checkXMatrix(vector<vector<int>>& grid) 
    {
    int k=grid.size();//rows
    int l=grid[0].size();//cols
    for(int i=0;i<l;i++)//rows
    { 
        for(int j=0;j<k;j++)//cols
        {
            if((i==0 && j==0) || (i==0 &&j==l-1) || (i==k-1 && j==0)|| (i==k-1 && j==l-1))
            {
                if(grid[i][j]!=0)
                {
                    continue;
                }
                else
                {
                    return false;
                }
            }
            else if((i==0 && j>0 && j<l-1))
            {
                if(grid[i][j]==0)
                {
                    continue;
                }
                else
                {
                    return false;
                }
            }
            else if((i>0 && j==0) || (i>0 && j==l-1))
            {
                if(grid[i][j]==0)
                {
                    continue;
                }
                else
                {
                    return false;
                }
            } 
            else if(i==k-1 && j>0 && j<l-1 )
            {
                if(grid[i][j]==0)
                {
                    continue;
                }
                else
                {
                    return false;
                }
            } 
        }
    }
    return true;    
    }
};
