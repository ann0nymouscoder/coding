class Solution {
public:
    vector<int> intersect(vector<int>& nums1, vector<int>& nums2) 
    {
        vector<int> intersect1;
        int i=nums1.size();
        int j=nums2.size();
    for(int k=0;k<i;k++)
    {
        for(int l=0;l<j;l++)
        {
            if(nums1[k]==nums2[l])
            {
             intersect1.push_back(nums1[k]);
             nums2[l] = INT_MIN;
             break;
            }
        }
        
    }
    return intersect1;    
    }
};
