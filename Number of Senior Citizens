class Solution {
public:
    int countSeniors(vector<string>& details) {
        int count = 0;
        for (int i = 0; i < details.size(); i++) {
            string s = details[i];
            int z1 = s[11] - '0';
            int z2 = s[12] - '0';
            int age = z1 * 10 + z2;

            if (age > 60) {
                count++;
            }
        }
        return count;    
    }
};
