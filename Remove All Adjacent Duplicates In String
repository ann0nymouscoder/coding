class Solution {
public:
    string removeDuplicates(string s) 
    {
    stack<char> put;
    stack<char> out;
    for(int i=0;i<s.length();i++)
    {
       if(!put.empty() && s[i] == put.top())
            {
                put.pop();
            }
            else
            {
                put.push(s[i]);
            }
    }
    s=""; 
        
        while(!put.empty())
        {
            s = put.top() + s;
            put.pop();
        }
    return s;

    }
};
