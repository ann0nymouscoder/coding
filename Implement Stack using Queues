class MyStack {
public:
    MyStack() {
        
    }
    
    void push(int x) {
        q.push(x);
        lens++;
    }
    
    int pop() {
        int tmplen = lens-1;
        while(tmplen-->0)
        {
            int a = q.front();
            q.pop();
            q.push(a);
        }
        int res = q.front(); q.pop();
        lens--;
        return res;
    }
    
    int top() {
        return q.back();
    }
    
    bool empty() {
        return lens==0;
    }
int lens{};
queue<int> q{};
};

