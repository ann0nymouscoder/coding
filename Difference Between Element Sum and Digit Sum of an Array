class Solution {
public:
    int differenceOfSum(vector<int>& nums) 
    {
    int sum=0;
    int element=0;
    
    for(int i=0;i<nums.size();i++)
    {
        sum=sum+nums[i];
        if(nums[i]>=10)
        {
            while(nums[i]>0)
            {
                element=element+nums[i]%10;
                nums[i]=nums[i]/10;
              
            }
        }
        else
        {
        element=element+nums[i];
        }
    }
    return sum-element;    
    }
};
