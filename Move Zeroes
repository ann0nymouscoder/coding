class Solution {
public:
    void moveZeroes(vector<int>& nums) 
    {
    int swap=0;
    for(int i=0;i<nums.size();i++)
    {
        for(int j=i+1;j<nums.size();j++)
        {
            if(nums[i]==0 && nums[j]!=0)
            {
                nums[i]=nums[j];
                nums[j]=swap;
                break;
                
            }
        }
    } 
      
    }
};
