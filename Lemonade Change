class Solution {
public:
    bool lemonadeChange(vector<int>& bills) 
    {
    int count=0;
    int ten=0;
    if(bills[0]==10 || bills[0]==20 )
    {
        return false;
    }
    for(int i=0;i<bills.size();i++)
    {
        if(bills[i]==5)
        {
            count++;
        }
        else if(bills[i]==10)
        {
            count=count-1;
            ten++;
        }
        else
        {
            if(ten!=0 && count!=0)
            {
                ten--;
                count--;
            }
            else

            {
                count=count-3;
            }
        }
        if(count<0)
        {
            return false;
        }
    }
    return true;   
    }
};
