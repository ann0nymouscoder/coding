class Solution {
public:
    bool containsDuplicate(vector<int>& nums) {
        unordered_map<int, int> seen;
        for (int num : nums) {
            if (seen[num] >= 1)
                return true;
            seen[num]++;
        }
        return false;
    }
};
class Solution {
public:
    bool containsDuplicate(vector<int>& nums) 
    {
    unordered_set<int> al;
    int k=nums.size();
    for(int i=0;i<k;i++)
    {
        if(al.count(nums[i]))
        {
            return true;
        }
        al.insert(nums[i]);
    }    
    return false;
    }
};
