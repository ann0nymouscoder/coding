class Solution {
public:
    bool checkStraightLine(vector<vector<int>>& coordinates) 
    {
        int k=coordinates.size();
        bool isVertical = true;
        for(int i = 1; i < k; i++)
        {
            if(coordinates[i][0] != coordinates[0][0]) 
            {
                isVertical = false;
                break;
            }
        }

        if(isVertical) return true;
        double slope = (coordinates[1][1] - coordinates[0][1]) / (double)(coordinates[1][0] - coordinates[0][0]);
        
        double a = 0, b = 0, c = 0, d = 0;
    
        for(int i = 2; i < k; i++)
        {
            c = coordinates[i-1][0];
            d = coordinates[i-1][1];
            
            a = coordinates[i][0];
            b = coordinates[i][1];
            
            if(a - c == 0) 
            {
                return false;
            }
            
            if((b - d) / (a - c) != slope)
            {
                return false;
            }
        }
        return true;
    }
};
