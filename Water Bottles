class Solution {
public:
    int numWaterBottles(int numBottles, int numExchange) {
        int count = numBottles;
        
        while (numBottles >= numExchange) {
            int newBottles = numBottles / numExchange;
            int rem = numBottles % numExchange;
            count += newBottles;
            numBottles = newBottles + rem;
        }
        
        return count;
    }
};
