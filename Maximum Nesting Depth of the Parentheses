class Solution {
public:
    int maxDepth(string s) 
    {
    stack<int> another;
    int k=s.length();
    int count=0;
    int maxi=0;
    for(int i=0;i<k;i++)
    {
        if(s[i]=='(')
        {
            another.push(s[i]);
            count++;
        }
        else if(s[i]==')')
        {
            another.pop();
            count--;
        }
        maxi=max(count,maxi);
    }
    return maxi;    
    }
};
