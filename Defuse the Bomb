class Solution {
public:
    vector<int> decrypt(vector<int>& code, int k) 
    {
    int h=code.size();
    int sum=0;
    vector<int> another=code;
    vector<int> self;
   if(k>0)
    {
        for(int i=0;i<h;i++)
        {
            for(int j=1;j<=k;j++)
            {
                sum+=another[(i+j)%h];
            }
            self.push_back(sum);
            sum=0;
        }
    }
    else if(k<0)
    {
        for(int i=0;i<h;i++)
        {
            for(int j=1;j<=-k;j++)
            {
                sum+=another[(i-j+h)%h];
            }
            self.push_back(sum);
            sum=0;
        }
    }
    else
    {
        for(int i=0;i<h;i++)
        {
            self.push_back(0);
        }
    }
    return self;
    }
};
