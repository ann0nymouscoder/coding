class Solution {
public:
    bool checkIfExist(vector<int>& arr) 
    {
    int k=arr.size();
    for(int i=0;i<k;i++)
    {
        if(i==k-1)
        {
            break;
        }
        for(int j=i+1;j<k;j++)
        {
            if(arr[i]==2*arr[j] || 2*arr[i]==arr[j])
            {
                return true;
            }
        }
    }
    return false ;   
    }
};
