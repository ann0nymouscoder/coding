class Solution {
public:
    string addBinary(string a, string b) 
    {
        int c = a.length() - 1;
        int d = b.length() - 1;
        int carry = 0;
        string result = "";
        
        while (c >= 0 || d >= 0 || carry) 
        {
            int sum = carry;
            
            if (c >= 0) 
            {
                sum += a[c] - '0';
                c--;
            }
            
            if (d >= 0) 
            {
                sum += b[d] - '0';
                d--;
            }
            
            result = char((sum % 2) + '0') + result;
            carry = sum / 2;
        }
        
        return result;
    }
};
