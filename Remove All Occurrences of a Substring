class Solution {
public:
    string removeOccurrences(string s, string part) 
    {
        stack<char> start;
        int i = 0, j = 0;
        string count = "";

        while (i < s.length()) 
        {
            start.push(s[i]);

            if (start.size() >= part.length()) 
            {
                string temp = "";
                for (int k = 0; k < part.length(); k++) 
                {
                    temp = start.top() + temp;
                    start.pop();
                }
                if (temp != part) 
                {
                    for (char c : temp) start.push(c);
                }
            }
            i++;
        }

        while (!start.empty()) 
        {
            count = start.top() + count;
            start.pop();
        }
        
        return count;
    }
};
