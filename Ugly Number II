class Solution {
private:
    void generateUglyNumbers(vector<int>& uglyNumbers, int i2, int i3, int i5, int n) {
        if (uglyNumbers.size() == n) return;

        int nextMultipleOf2 = uglyNumbers[i2] * 2;
        int nextMultipleOf3 = uglyNumbers[i3] * 3;
        int nextMultipleOf5 = uglyNumbers[i5] * 5;

        int nextUglyNumber = min({nextMultipleOf2, nextMultipleOf3, nextMultipleOf5});
        uglyNumbers.push_back(nextUglyNumber);

        if (nextUglyNumber == nextMultipleOf2) i2++;
        if (nextUglyNumber == nextMultipleOf3) i3++;
        if (nextUglyNumber == nextMultipleOf5) i5++;

        generateUglyNumbers(uglyNumbers, i2, i3, i5, n);
    }

public:
    int nthUglyNumber(int n) {
        if (n == 1) return 1;

        vector<int> uglyNumbers = {1};
        generateUglyNumbers(uglyNumbers, 0, 0, 0, n);

        return uglyNumbers.back();
    }
};
