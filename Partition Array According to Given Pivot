class Solution {
public:
    vector<int> pivotArray(vector<int>& nums, int pivot) 
    {
        int k=nums.size();
        vector<int> less;
        vector<int> equal;
        vector<int> more;
        vector<int>total;
        int i=0;
        for( i=0;i<k;i++)
        {
            if(nums[i]<pivot)
            {
                less.push_back(nums[i]);
            }
            else if(nums[i]>pivot)
            {
                more.push_back(nums[i]);
            }
            else
            {
                equal.push_back(nums[i]);
            }
        }
        for(i=0;i<less.size();i++)
        {
                total.push_back(less[i]);
            
        }
        for(i=0;i<equal.size();i++)
        {
                total.push_back(equal[i]);
            
        }
        for(i=0;i<more.size();i++)
        {
                total.push_back(more[i]);
            
        }
             return total;
        }
    };
