class Solution {
public:
    int addDigits(int num) 
    {
        if (num <= 9)
        {
            return num;
        }

        int count = 0;
        while (num > 9)
        {
            count = 0;
            while (num > 0)
            {
                count += num % 10;
                num = num / 10;
            }
            num = count;
        }
        return num;
    }
};
