class Solution {
public:
    vector<bool> kidsWithCandies(vector<int>& candies, int extraCandies) 
    {
    int max1=candies[0];
    int i=0;
    vector<bool> p;
    int k=candies.size();
    for( i=1;i<k;i++)
    {
        if(candies[i]>max1)
        {
            max1=candies[i];
        }
    }    
    for(i=0;i<k;i++)
    {
        if(extraCandies+candies[i]>=max1)
        {
            p.push_back(true);
        }
        else
        {
             p.push_back(false);
        }
    }
    return p;
    }
};
