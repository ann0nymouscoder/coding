class Solution {
public:
    int findLengthOfLCIS(vector<int>& nums) 
    {
    int count=1;
    int k=nums.size(); 
    int maxi=0;
    for(int i=0;i<k-1;i++)
    {
        if(nums[i]<nums[i+1])
        {
            if(i==k-2)
            {
                count=count+1;
                break;
            }
            count++;
        }
        
        else
        {
             maxi=max(maxi,count);
            count=1;
        }
    }    
     maxi=max(maxi,count);
    return maxi;
    }
};
